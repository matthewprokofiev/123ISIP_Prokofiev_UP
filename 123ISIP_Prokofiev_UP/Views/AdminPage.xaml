<Page x:Class="_123ISIP_Prokofiev_UP.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Segoe UI" Background="{StaticResource PageBackground}"
      Title="Администрирование">
    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Администрирование" Style="{StaticResource H1}"/>

        <!-- Вкладки разделов -->
        <WrapPanel Grid.Row="1" Margin="0,18,0,16">
            <RadioButton x:Name="TabComplaints" Content="Жалобы" GroupName="adm" Style="{StaticResource Pill}" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabUnfreeze" Content="Заявки на разморозку" GroupName="adm" Style="{StaticResource Pill}" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabRoles" Content="Заявки на роль" GroupName="adm" Style="{StaticResource Pill}" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabFrozen" Content="Замороженные" GroupName="adm" Style="{StaticResource Pill}" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabUsers" Content="Пользователи" GroupName="adm" Style="{StaticResource Pill}" Checked="Tab_Checked"/>
        </WrapPanel>

        <Grid Grid.Row="2">

            <!-- ============ Жалобы ============ -->
            <ScrollViewer x:Name="PanelComplaints" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl x:Name="ComplaintsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding ComplainantLogin, StringFormat=Жалоба от: {0}}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding StatusName, StringFormat=Статус: {0}}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button Content="Принять" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,0,6" Click="ComplaintAccept_Click"/>
                                        <Button Content="Отклонить" Style="{StaticResource SecondaryButton}" Padding="14,6" Click="ComplaintReject_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============ Заявки на разморозку ============ -->
            <ScrollViewer x:Name="PanelUnfreeze" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Visibility="Collapsed">
                <ItemsControl x:Name="UnfreezeItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding UserLogin, StringFormat=Заявитель: {0}}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding StatusName, StringFormat=Статус: {0}}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button Content="Принять" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,0,6" Click="UnfreezeAccept_Click"/>
                                        <Button Content="Отклонить" Style="{StaticResource SecondaryButton}" Padding="14,6" Click="UnfreezeReject_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============ Заявки на роль ============ -->
            <ScrollViewer x:Name="PanelRoles" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Visibility="Collapsed">
                <ItemsControl x:Name="RolesItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                            <Run Text="{Binding UserLogin}"/><Run Text=" → роль «"/><Run Text="{Binding RequestedRoleName}"/><Run Text="»"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusName, StringFormat=Статус: {0}}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button Content="Принять" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,0,6" Click="RoleAccept_Click"/>
                                        <Button Content="Отклонить" Style="{StaticResource SecondaryButton}" Padding="14,6" Click="RoleReject_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============ Замороженные ============ -->
            <ScrollViewer x:Name="PanelFrozen" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Замороженные книги" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="FrozenBooksItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding AuthorName, StringFormat=Автор: {0}}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Разморозить" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="UnfreezeBook_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Замороженные пользователи" Style="{StaticResource H2}" Margin="0,16,0,8"/>
                    <ItemsControl x:Name="FrozenUsersItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Login}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Разморозить" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="UnfreezeUser_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Замороженные отзывы" Style="{StaticResource H2}" Margin="0,16,0,8"/>
                    <ItemsControl x:Name="FrozenReviewsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                                <Run Text="{Binding UserLogin}"/><Run Text=" о «"/><Run Text="{Binding BookTitle}"/><Run Text="»"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ReviewText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Разморозить" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="UnfreezeReview_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Пользователи ============ -->
            <ScrollViewer x:Name="PanelUsers" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Visibility="Collapsed">
                <ItemsControl x:Name="UsersItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Login}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="7,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding RoleName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#FBE3DC" CornerRadius="6" Padding="7,2" Margin="6,0,0,0"
                                                    Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="❄ заморожен" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Content="Роль" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="AssignRole_Click"/>
                                        <Button Content="Пароль" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="6,0,0,0" Click="ChangePassword_Click"/>
                                        <Button Padding="12,6" Margin="6,0,0,0" Click="ToggleFreezeUser_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="Заморозить"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                            <Setter Property="Content" Value="Разморозить"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Text="Список пуст" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
