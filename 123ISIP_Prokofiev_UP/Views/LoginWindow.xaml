<Window x:Class="_123ISIP_Prokofiev_UP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши — вход" Height="640" Width="980"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{StaticResource PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая «обложка» -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel VerticalAlignment="Center" Margin="48">
                <Path Data="{StaticResource Icon.Book}" Fill="{StaticResource AccentBrush}"
                      Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Left"/>
                <TextBlock Text="Читай, Пиши" Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,24,0,0"/>
                <TextBlock Text="и не спиши" Foreground="{StaticResource AccentBrush}" FontSize="40" FontWeight="Bold"/>
                <TextBlock Foreground="#B9B4AD" FontSize="15" TextWrapping="Wrap" Margin="0,20,0,0"
                           Text="Пространство свободного распространения книг начинающих авторов. Читайте, публикуйте, обсуждайте."/>
            </StackPanel>
        </Border>

        <!-- Правая панель форм -->
        <Border Grid.Column="1" Background="{StaticResource PageBackground}">
            <Grid Margin="48" VerticalAlignment="Center">
                <!-- Переключатель -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <RadioButton x:Name="TabLogin" Content="Вход" GroupName="mode" IsChecked="True"
                                     FontSize="16" FontWeight="SemiBold" Margin="0,0,24,0" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabRegister" Content="Регистрация" GroupName="mode"
                                     FontSize="16" FontWeight="SemiBold" Checked="Tab_Checked"/>
                    </StackPanel>

                    <!-- Форма входа -->
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="Логин" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <TextBox x:Name="LoginLogin" Style="{StaticResource Field}" Margin="0,0,0,14"/>
                        <TextBlock Text="Пароль" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <PasswordBox x:Name="LoginPassword" Padding="10,8" FontSize="14" Margin="0,0,0,20"
                                     KeyDown="LoginPassword_KeyDown"/>
                        <Button Content="Войти" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0" TextWrapping="Wrap"
                                   Text="Тестовые учётные записи: admin / admin (администратор), ivan_author / 1234 (автор), reader_kate / 1234 (читатель)."/>
                    </StackPanel>

                    <!-- Форма регистрации -->
                    <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                        <TextBlock Text="Отображаемое имя" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <TextBox x:Name="RegName" Style="{StaticResource Field}" Margin="0,0,0,12"/>
                        <TextBlock Text="Логин" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <TextBox x:Name="RegLogin" Style="{StaticResource Field}" Margin="0,0,0,12"/>
                        <TextBlock Text="Email" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <TextBox x:Name="RegEmail" Style="{StaticResource Field}" Margin="0,0,0,12"/>
                        <TextBlock Text="Пароль" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <PasswordBox x:Name="RegPassword" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock Text="Повторите пароль" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                        <PasswordBox x:Name="RegPassword2" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>
                        <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" Click="Register_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
