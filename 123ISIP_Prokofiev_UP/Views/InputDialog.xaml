<Window x:Class="_123ISIP_Prokofiev_UP.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод" Height="260" Width="440" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PageBackground}" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource Field}"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" Click="Cancel_Click"/>
            <Button Content="ОК" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
