<Page x:Class="_123ISIP_Prokofiev_UP.Views.BookEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Segoe UI" Background="{StaticResource PageBackground}"
      Title="Книга — редактирование">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="760" HorizontalAlignment="Left">

            <Button Content="← Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Width="110" Margin="0,0,0,16" Click="Back_Click"/>

            <TextBlock x:Name="HeaderText" Text="Новая книга" Style="{StaticResource H1}"/>

            <TextBlock Text="Название *" Style="{StaticResource Muted}" Margin="2,18,0,4"/>
            <TextBox x:Name="TitleBox" Style="{StaticResource Field}"/>

            <TextBlock Text="Описание" Style="{StaticResource Muted}" Margin="2,14,0,4"/>
            <TextBox x:Name="DescriptionBox" Style="{StaticResource Field}" Height="80" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Путь к обложке" Style="{StaticResource Muted}" Margin="2,14,0,4"/>
            <TextBox x:Name="CoverBox" Style="{StaticResource Field}"/>

            <TextBlock Text="Текст книги" Style="{StaticResource Muted}" Margin="2,14,0,4"/>
            <TextBox x:Name="ContentBox" Style="{StaticResource Field}" Height="160" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Жанры" Style="{StaticResource Muted}" Margin="2,14,0,6"/>
            <Border Style="{StaticResource Card}" Padding="14">
                <ItemsControl x:Name="GenresItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Genre.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,20,8" FontSize="14" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="SaveBtn" Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="150" Click="Save_Click"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="130" Margin="10,0,0,0" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
