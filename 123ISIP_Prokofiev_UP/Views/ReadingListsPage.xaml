<Page x:Class="_123ISIP_Prokofiev_UP.Views.ReadingListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Segoe UI" Background="{StaticResource PageBackground}"
      Title="Списки книг">
    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Списки книг" Style="{StaticResource H1}"/>

        <StackPanel x:Name="TabsPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0"/>

        <Grid Grid.Row="2" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,0" Height="42" Width="400"
                    HorizontalAlignment="Left" Cursor="IBeam" MouseLeftButtonUp="SearchArea_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Fill="{StaticResource MutedBrush}"
                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="14" TextChanged="Filter_Changed"/>
                        <TextBlock Text="Поиск по названию или автору" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <ComboBox x:Name="GenreFilter" Grid.Column="1" Width="180" Height="42" Margin="12,0,0,0"
                      VerticalContentAlignment="Center" FontSize="14" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Grid.Column="2" Width="230" Height="42" Margin="12,0,0,0"
                      Padding="10,0,8,0" VerticalContentAlignment="Center" FontSize="14" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Сортировка: по названию" Tag="title" IsSelected="True"/>
                <ComboBoxItem Content="Сортировка: по оценке" Tag="rating"/>
            </ComboBox>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="BooksItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="232" Margin="0,0,18,18">
                            <StackPanel>
                                <Border Height="140" CornerRadius="12,12,0,0" Cursor="Hand"
                                        Background="{Binding Converter={StaticResource CoverConv}, ConverterParameter=brush}"
                                        MouseLeftButtonUp="Open_Click">
                                    <Grid>
                                        <Path Data="{StaticResource Icon.Book}" Fill="#55E8E4DD" Width="52" Height="52" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding Converter={StaticResource CoverConv}, ConverterParameter=icon}"/>
                                        <Border Background="{StaticResource StarBrush}" CornerRadius="8" Padding="7,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Star}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AvgRatingText}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14,12,14,14">
                                    <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Height="40" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AuthorName}" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Переместить" Style="{StaticResource SecondaryButton}"
                                                Padding="0,7" FontSize="12" Click="Move_Click"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                                Padding="10,7" ToolTip="Убрать из списка" Click="Remove_Click">
                                            <Path Data="{StaticResource Icon.Flag}" Fill="{StaticResource AccentDarkBrush}" Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="3" Text="В этом разделе пока нет книг" Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed"/>
    </Grid>
</Page>
