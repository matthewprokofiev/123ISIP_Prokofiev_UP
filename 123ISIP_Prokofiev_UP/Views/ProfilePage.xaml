<Page x:Class="_123ISIP_Prokofiev_UP.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Segoe UI" Background="{StaticResource PageBackground}"
      Title="Профиль">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Профиль" Style="{StaticResource H1}"/>

            <Border x:Name="FrozenPanel" Background="#FBE3DC" CornerRadius="12" Padding="20" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Frozen}" Fill="{StaticResource AccentDarkBrush}" Width="22" Height="22" Stretch="Uniform"/>
                        <TextBlock Text="Аккаунт заморожен" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="FreezeReasonText" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Ваш аккаунт заморожен администрацией за нарушение правил сообщества. Вы можете оспорить это решение."/>
                    <Button Content="Оспорить заморозку" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="ContestFreeze_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="90" Height="90" CornerRadius="45" Background="{StaticResource SidebarBrush}" VerticalAlignment="Top">
                        <Path Data="{StaticResource Icon.Profile}" Fill="{StaticResource IconBrush}" Width="48" Height="48" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Style="{StaticResource H2}" FontSize="22"/>
                        <TextBlock x:Name="LoginText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="EmailText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0"/>
                        <Border x:Name="RoleBadge" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="10,4"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <TextBlock x:Name="RoleText" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="RoleRequestPanel" Style="{StaticResource Card}" Padding="20" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Хотите публиковать свои книги?" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Подайте заявку на получение роли «Автор». После одобрения администратором вы сможете добавлять и редактировать книги."/>
                    <Button x:Name="RoleRequestBtn" Content="Подать заявку на роль Автора" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="RequestAuthor_Click"/>
                    <TextBlock x:Name="RoleRequestPending" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed"
                               Text="Ваша заявка на роль Автора находится на рассмотрении."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Мои отзывы" Style="{StaticResource H2}" Margin="0,26,0,10"/>
            <TextBlock x:Name="NoReviewsText" Text="Вы пока не оставляли отзывов." Style="{StaticResource Muted}" Visibility="Collapsed"/>
            <ItemsControl x:Name="ReviewsItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="Review_Open">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <Border Background="{StaticResource StarBrush}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Star}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rating}" Foreground="White" FontWeight="Bold" FontSize="11" Margin="3,0,0,0"/>
                                                <TextBlock Text="/10" Foreground="White" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Style="{StaticResource Muted}" FontSize="12"/>
                                </Grid>
                                <TextBlock Text="{Binding ReviewText}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
