<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:_123ISIP_Prokofiev_UP.Services">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <svc:CoverConverter x:Key="CoverConv"/>

    <Color x:Key="SidebarColor">#2D2A32</Color>
    <Color x:Key="AccentColor">#E07A5F</Color>

    <SolidColorBrush x:Key="SidebarBrush"      Color="#2D2A32"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#3F3A47"/>
    <SolidColorBrush x:Key="IconBrush"         Color="#E8E4DD"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="#E07A5F"/>
    <SolidColorBrush x:Key="AccentDarkBrush"   Color="#C8553D"/>
    <SolidColorBrush x:Key="PageBackground"    Color="#F4F1EC"/>
    <SolidColorBrush x:Key="CardBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush"         Color="#2D2A32"/>
    <SolidColorBrush x:Key="MutedBrush"        Color="#8A8580"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#E0DBD2"/>
    <SolidColorBrush x:Key="StarBrush"         Color="#E6A532"/>

